// Two bars from one shared definition (modules.jsonc).
// "name" sets the layer-shell namespace, which is how hyprglass picks a bar to
// glass. Glass only goes on DP-5: hyprglass' layer pass ignores monitor
// transform, so on the rotated DP-7 the layer renders outside the visible
// region and the bar disappears.
[
  {
    "name": "glassbar",
    "output": ["!DP-5"],
    "include": ["~/.config/waybar/modules.jsonc"],
  },
  {
    "name": "plainbar",
    "include": ["~/.config/waybar/modules.jsonc"],
  },
]
